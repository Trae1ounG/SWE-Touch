{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swe-touch.github.io/schema/candidates-v1.schema.json",
  "title": "SWE-Touch Counter-Edit candidates",
  "type": "object",
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instance_id", "candidate_id", "diff", "target_regions"],
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "diff": {"type": "string", "pattern": "^diff --git "},
          "target_regions": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "dataset-record-v1.schema.json#/$defs/region"}
          }
        }
      }
    }
  }
}
